{
  "name": "@autoxeo/codex-plugin",
  "version": "0.6.0",
  "private": false,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stella-dust/autoxeo-agent-codex-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/stella-dust/autoxeo-agent-codex-plugin/issues"
  },
  "type": "module",
  "files": [
    ".codex-plugin/",
    ".mcp.json",
    "assets/",
    "dist/",
    "skills/",
    "README.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build:ui": "vite build",
    "build:server": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/server.mjs --sourcemap --legal-comments=none",
    "build": "npm run clean && npm run build:ui && npm run build:server",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src ui tests vite.config.ts",
    "test": "vitest run --root .",
    "test:watch": "vitest --root .",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "validate": "node scripts/validate-plugin.mjs",
    "smoke:mcp": "node scripts/smoke-mcp.mjs",
    "smoke:webui": "node scripts/smoke-webui.mjs",
    "preview:webui": "node scripts/preview-webui.mjs",
    "package:beta": "npm run check && npm run validate && node scripts/package-beta.mjs",
    "package:github-release": "npm run check && npm run validate && npm run smoke:mcp && npm run smoke:webui && node scripts/package-github-release.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^27.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vite": "^7.2.4",
    "vitest": "^4.0.15"
  }
}
